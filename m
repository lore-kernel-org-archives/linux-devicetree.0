> +		 */
> +		if (irqd_is_wakeup_set(pdc_irqd) &&
> +		    !irqd_is_level_type(pdc_irqd)) {
> +			disable_irq_nosync(irq);
> +			enable_irq_wake(irqd->irq);
> +			enable_irq(irqd->irq);
> +		}
