   419	
   420	static void tegra_sdhci_pad_autocalib(struct sdhci_host *host)
   421	{
   422		struct sdhci_pltfm_host *pltfm_host = sdhci_priv(host);
   423		struct sdhci_tegra *tegra_host = sdhci_pltfm_priv(pltfm_host);
   424		struct sdhci_tegra_autocal_offsets offsets =
   425				tegra_host->autocal_offsets;
   426		struct mmc_ios *ios = &host->mmc->ios;
   427		bool card_clk_enabled;
   428		u16 pdpu;
   429		u32 reg;
   430		int ret;
   431	
   432		switch (ios->timing) {
   433		case MMC_TIMING_UHS_SDR104:
   434			pdpu = offsets.pull_down_sdr104 << 8 | offsets.pull_up_sdr104;
   435			break;
   436		case MMC_TIMING_MMC_HS400:
   437			pdpu = offsets.pull_down_hs400 << 8 | offsets.pull_up_hs400;
   438			break;
   439		default:
   440			if (ios->signal_voltage == MMC_SIGNAL_VOLTAGE_180)
   441				pdpu = offsets.pull_down_1v8 << 8 | offsets.pull_up_1v8;
   442			else
   443				pdpu = offsets.pull_down_3v3 << 8 | offsets.pull_up_3v3;
   444		}
   445	
   446		/* Set initial offset before auto-calibration */
   447		tegra_sdhci_set_pad_autocal_offset(host, pdpu);
   448	
   449		card_clk_enabled = tegra_sdhci_configure_card_clk(host, false);
   450	
   451		tegra_sdhci_configure_cal_pad(host, true);
   452	
   453		reg = sdhci_readl(host, SDHCI_TEGRA_AUTO_CAL_CONFIG);
   454		reg |= SDHCI_AUTO_CAL_ENABLE | SDHCI_AUTO_CAL_START;
   455		sdhci_writel(host, reg, SDHCI_TEGRA_AUTO_CAL_CONFIG);
   456	
   457		usleep_range(1, 2);
   458		/* 10 ms timeout */
   459		ret = readl_poll_timeout(host->ioaddr + SDHCI_TEGRA_AUTO_CAL_STATUS,
   460					 reg, !(reg & SDHCI_TEGRA_AUTO_CAL_ACTIVE),
   461					 1000, 10000);
   462	
   463		tegra_sdhci_configure_cal_pad(host, false);
   464	
   465		tegra_sdhci_configure_card_clk(host, card_clk_enabled);
   466	
   467		if (ret) {
   468			dev_err(mmc_dev(host->mmc), "Pad autocal timed out\n");
   469	
   470			/* Disable automatic cal and use fixed Drive Strengths */
   471			reg = sdhci_readl(host, SDHCI_TEGRA_AUTO_CAL_CONFIG);
   472			reg &= ~SDHCI_AUTO_CAL_ENABLE;
   473			sdhci_writel(host, reg, SDHCI_TEGRA_AUTO_CAL_CONFIG);
   474	
   475			ret = tegra_sdhci_set_padctrl(host, ios->signal_voltage, false);
   476			if (ret < 0)
