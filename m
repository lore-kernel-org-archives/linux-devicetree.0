+/dts-v1/;
+/include/ "meson8.dtsi"
+
+/ {
+	model = "Tronsmart Vega S89 Elite";
+	compatible = "tronsmart,vega-s89e", "amlogic,meson8";
+
+	aliases {
+		serial0 = &uart_AO;
+	};
+
+	memory {
+		reg = <0x40000000 0x80000000>;
+	};
+};
+
+&uart_AO {
+	status = "okay";
+};
